#:culture{:id "irl.dish.colcannon", :name "Colcannon", :country "IRL", :kind :dish, :summary "Traditional Irish dish of mashed potatoes with cabbage, popular on Saint Patrick's Day and the feast day of St. Brigid.", :url "https://en.wikipedia.org/wiki/Colcannon", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "irl.dish.soda-bread", :name "Soda bread", :country "IRL", :kind :dish, :summary "Quick bread leavened with sodium bicarbonate instead of yeast, made from flour, baking soda, salt and buttermilk; it originated in the United Kingdom and has strong associations with Irish culinary tradition.", :url "https://en.wikipedia.org/wiki/Soda_bread", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "irl.dish.boxty", :name "Boxty", :country "IRL", :kind :dish, :summary "Traditional Irish potato pancake of finely grated raw potato and flour fried on a griddle, associated with the north midlands, Connacht and Ulster.", :url "https://en.wikipedia.org/wiki/Boxty", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "irl.beverage.guinness", :name "Guinness", :country "IRL", :kind :beverage, :summary "Stout that originated in the brewery of Arthur Guinness at St. James's Gate, Dublin, Ireland, in the 18th century.", :url "https://en.wikipedia.org/wiki/Guinness", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "irl.beverage.irish-whiskey", :name "Irish whiskey", :country "IRL", :kind :beverage, :summary "Distilled spirit made on the island of Ireland from malted cereals, matured at least three years in wooden casks; a protected European geographical indication under Regulation (EC) No 110/2008.", :url "https://en.wikipedia.org/wiki/Irish_whiskey", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "irl.craft.aran-jumper", :name "Aran jumper", :country "IRL", :kind :craft, :summary "Cable-knit sweater from the Aran Islands off the west coast of Ireland, traditionally made from cream-colored wool with natural water-resistant properties.", :url "https://en.wikipedia.org/wiki/Aran_jumper", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
#:culture{:id "irl.craft.claddagh-ring", :name "Claddagh ring", :country "IRL", :kind :craft, :summary "Traditional Irish ring whose heart, crown and clasped hands represent love, loyalty and friendship; its modern form originated in the 17th century in the fishing village of Claddagh near Galway.", :url "https://en.wikipedia.org/wiki/Claddagh_ring", :url-provenance :wikipedia-en, :retrieved-at "2026-07-17"}
